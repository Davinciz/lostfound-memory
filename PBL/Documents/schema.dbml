// Lost & Found Database Schema
// updated: 2026-11-01 (conversations: 4 kolom timestamp nullable arsip/hapus per slot user, migration 2026_11_01_103035; tetap 7 tabel. Riwayat: 2026-10-23 claims.lost_report_id & found_report_id NULLABLE + CHECK claims_target_report_check, migration 2026_10_23_000001; index chat partial unique + composite 2026-10-18)
// Skema PostgreSQL; struktur Google SSO diterapkan 2026-10-10 (user melaporkan migration selesai).
// Catatan: photo_urls (lost/found_reports) & proof_of_transfer_photo_url (claims) menyimpan PATH RELATIF (mis. reports/uuid.jpg); URL lengkap dibangun di response API dari APP_URL.
// Docs: https://dbml.dbdiagram.io/docs
//
// Catatan:
// - Semua id memakai tipe uuid asli PostgreSQL
// - Nilai status disimpan HURUF KECIL dan dijaga check constraint di database
// - Tabel bawaan Laravel (cache, jobs, sessions, personal_access_tokens, dll.) tidak dimasukkan
// - NIM opsional; mahasiswa dapat memperoleh NIM otomatis dari email bila pola cocok. Role aplikasi: user | admin.
// - Google SSO diterapkan: email 3 domain Polines; password nullable untuk user SSO dan tetap dipakai admin.
// - 2026-10-14: Tiga kolom baru di claims disetujui (accepted_at, closed_reason, closed_by) — DITERAPKAN 2026-10-23 (migration 2026_10_23_000001, merge develop PR #6).
// - 2026-10-23: claims.lost_report_id & found_report_id nullable (claim langsung ke laporan target, laporan sendiri opsional).
// - 2026-11-01: conversations dapat 4 kolom timestamp nullable arsip/hapus per slot user
//   (user1_archived_at, user2_archived_at, user1_deleted_at, user2_deleted_at), migration 2026_11_01_103035. Tetap 7 tabel.

Table users {
  id uuid [primary key]
  nim varchar [unique, note: 'Opsional; otomatis dari email mahasiswa bila pola cocok']
  name varchar [not null]
  email varchar [unique]
  email_verified_at timestamp
  password varchar [note: 'Nullable untuk user SSO; dipakai admin Filament']
  role varchar [not null, default: 'user', note: 'user | admin']
  fcm_token varchar [note: 'Firebase Cloud Messaging token for push notifications']
  profile_image_url varchar
  whatsapp varchar
  wa_visible boolean [default: false, note: 'WhatsApp visibility control']
  blocked boolean [default: false, note: 'Akun diblokir (Security Hardening)']
  blocked_reason varchar [note: 'Alasan blokir']
  remember_token varchar
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    nim
    role
  }
}

Table buildings {
  id uuid [primary key]
  name varchar [not null]
  code varchar [note: 'Contoh: GSA, GKT, LTM']
  type varchar [default: 'gedung', note: 'gedung | lab | bengkel | parkiran | fasilitas']
  latitude decimal(10,8) [not null]
  longitude decimal(11,8) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    type
    (latitude, longitude) [name: 'idx_buildings_coords']
  }
}

Table lost_reports {
  id uuid [primary key]
  code varchar [unique, note: 'Kode laporan mudah dibaca, mis. LST-261001-A3F9']
  reporter_id uuid [not null, note: 'User who reported lost item']
  building_id uuid [note: 'Nullable. Dipilih user dari daftar saran gedung atau tap marker; bukan auto-detect; tidak menimpa koordinat']
  title varchar [not null]
  description text [not null]
  category varchar [not null, note: 'buku | elektronik | jaket_kemeja | dompet | aksesoris | alat_tulis | lainnya']
  lost_date date [not null]
  latitude decimal(10,8) [not null, note: 'Titik pin yang dipilih user di peta']
  longitude decimal(11,8) [not null, note: 'Titik pin yang dipilih user di peta']
  location_name varchar [note: 'Aturan: gedung+detail → "Nama Gedung, detail"; gedung saja → "Nama Gedung"; tanpa gedung+detail → detail; tanpa gedung+detail kosong → "Titik di peta (area luar gedung)"']
  photo_urls json [not null, note: 'Array of relative photo paths (mis. reports/uuid.jpg); URL dibangun di response dari APP_URL']
  status varchar [default: 'pending', note: 'pending | claimed | returned | closed (huruf kecil)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    category
    status
  }
}

Table found_reports {
  id uuid [primary key]
  code varchar [unique, note: 'Kode laporan mudah dibaca, mis. FND-261001-B7K2']
  reporter_id uuid [not null, note: 'User who found the item']
  building_id uuid [note: 'Nullable. Dipilih user dari daftar saran gedung atau tap marker; bukan auto-detect; tidak menimpa koordinat']
  title varchar [not null]
  description text [not null]
  category varchar [not null, note: 'buku | elektronik | jaket_kemeja | dompet | aksesoris | alat_tulis | lainnya']
  found_date timestamp [not null]
  latitude decimal(10,8) [not null, note: 'Titik pin yang dipilih user di peta']
  longitude decimal(11,8) [not null, note: 'Titik pin yang dipilih user di peta']
  location_name varchar [note: 'Aturan: gedung+detail → "Nama Gedung, detail"; gedung saja → "Nama Gedung"; tanpa gedung+detail → detail; tanpa gedung+detail kosong → "Titik di peta (area luar gedung)"']
  photo_urls json [not null, note: 'Array of relative photo paths (mis. reports/uuid.jpg); URL dibangun di response dari APP_URL']
  status varchar [default: 'pending', note: 'pending | claimed | returned | closed (huruf kecil)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    category
    status
  }
}

Table claims {
  // 2026-10-23: lost_report_id & found_report_id NULLABLE (migration 2026_10_23_000001_make_claim_reports_nullable).
  // Teks lama (riwayat, tidak dihapus): "RENCANA 2026-10-19 (belum ada migration): keduanya nullable + CHECK minimal salah satu terisi."
  // DBML tidak mendukung CHECK; aturan ditulis sebagai catatan:
  //   CHECK claims_target_report_check: (lost_report_id IS NOT NULL OR found_report_id IS NOT NULL)
  id uuid [primary key]
  lost_report_id uuid [note: 'Nullable sejak 2026-10-23. Claim langsung ke laporan target; laporan sendiri opsional']
  found_report_id uuid [note: 'Nullable sejak 2026-10-23. Claim langsung ke laporan target; laporan sendiri opsional']
  claimant_id uuid [not null, note: 'Pengaju claim (pemilik atau penemu)']
  status varchar [default: 'pending', note: 'pending | accepted | returned | rejected | withdrawn (huruf kecil)']
  reason text [note: 'Alasan pengajuan claim']
  admin_note text [note: 'Catatan admin']
  accepted_at timestamp [note: 'Waktu konfirmasi diterima oleh penerima (untuk hitung kedaluwarsa 7 hari) — ada sejak migration 2026_10_23_000001']
  closed_reason text [note: 'Alasan penutupan (rejected/withdrawn/expired) — ada sejak migration 2026_10_23_000001']
  closed_by uuid [note: 'User yang menutup (pengaju/penerima/admin), NULL = sistem — ada sejak migration 2026_10_23_000001']
  proof_of_transfer_photo_url varchar [note: 'Path relatif foto bukti serah terima (mis. claims/proof/uuid.jpg); URL dibangun di response dari APP_URL']
  transferred_at timestamp [note: 'Waktu barang diserahkan']
  transferred_by uuid [note: 'User yang menandai transfer (admin/finder/claimant)']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    status
    accepted_at [note: 'Untuk query expire — index ada sejak migration 2026-10-23']
  }
}

Table conversations {
  id uuid [primary key]
  lost_report_id uuid [note: 'Nullable']
  found_report_id uuid [note: 'Nullable']
  claim_id uuid [note: 'Nullable. Terisi jika chat dibuat dari claim']
  user1_id uuid [not null, note: 'mis. claimant/pengaju (cabang claim) atau user id min (chat langsung)']
  user2_id uuid [not null, note: 'mis. penerima/pelapor laporan target (cabang claim) atau user id max (chat langsung)']
  user1_archived_at timestamp [note: 'Nullable. Arsip manual/otomatis untuk user1. Migration 2026_11_01_103035']
  user2_archived_at timestamp [note: 'Nullable. Arsip manual/otomatis untuk user2']
  user1_deleted_at timestamp [note: 'Nullable. "Hapus untuk saya" oleh user1; batas riwayat pesan yang tampil untuknya']
  user2_deleted_at timestamp [note: 'Nullable. "Hapus untuk saya" oleh user2']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    claim_id
    user1_id
    user2_id
  }
  // Partial unique index (DBML belum mendukung partial index native; dicatat di sini):
  //   UNIQUE (claim_id) WHERE claim_id IS NOT NULL      -- satu chat per claim
  //   UNIQUE (user1_id, user2_id) WHERE claim_id IS NULL -- satu chat langsung per pasangan user
  //   Pasangan user dinormalisasi min/max saat pembuatan chat langsung.
  // Migration: 2026_10_18_071626_add_conversation_indexes (2026-10-18)
}

Table messages {
  id uuid [primary key]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  message text [not null]
  read_at timestamp [note: 'Null = belum dibaca']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    conversation_id
    sender_id
    created_at
  }
  // Composite index (2026-10-18): (conversation_id, created_at) untuk query urutan pesan.
  // Migration: 2026_10_18_071626_add_conversation_indexes
}

// Relationships (semua sudah terverifikasi ada di database)
Ref user_lost_reports: lost_reports.reporter_id > users.id [delete: cascade]
Ref user_found_reports: found_reports.reporter_id > users.id [delete: cascade]
Ref user_claims: claims.claimant_id > users.id [delete: cascade]
Ref claim_lost_report: claims.lost_report_id > lost_reports.id [delete: cascade]
Ref claim_found_report: claims.found_report_id > found_reports.id [delete: cascade]

// Master Buildings
Ref building_lost_reports: lost_reports.building_id > buildings.id [delete: set null]
Ref building_found_reports: found_reports.building_id > buildings.id [delete: set null]

// Foto Bukti Transfer
Ref claim_transferred_by: claims.transferred_by > users.id [delete: set null]

// Penutup claim
Ref claim_closed_by: claims.closed_by > users.id [delete: set null]

// Real-Time Chat
Ref conversation_user1: conversations.user1_id > users.id [delete: cascade]
Ref conversation_user2: conversations.user2_id > users.id [delete: cascade]
Ref conversation_claim: conversations.claim_id > claims.id [delete: set null]
Ref conversation_lost_report: conversations.lost_report_id > lost_reports.id [delete: set null]
Ref conversation_found_report: conversations.found_report_id > found_reports.id [delete: set null]
Ref message_conversation: messages.conversation_id > conversations.id [delete: cascade]
Ref message_sender: messages.sender_id > users.id [delete: cascade]
